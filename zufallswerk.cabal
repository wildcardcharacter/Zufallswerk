cabal-version: 3.0
name: zufallswerk
version: 2.1.0
build-type: Simple

extra-source-files:
    THIRD_PARTY_NOTICES.md
    assets/words/words_de.txt
    assets/words/words_en_eff.txt
    assets/logo/zufallswerk-256.png
    data/style.css

executable zufallswerk
    main-is: Main.hs
    other-modules:
        Zufallswerk.Core
        Zufallswerk.Password
        Zufallswerk.Passphrase
        Zufallswerk.Language
        Zufallswerk.Settings
        Paths_zufallswerk
    hs-source-dirs: app src
    default-language: Haskell2010

    build-depends:
        base >= 4.17 && < 5,
        bytestring,
        gi-gtk,
        gi-gdk,
        text,
        process,
        directory,
        filepath

    ghc-options: -Wall

test-suite zufallswerk-tests
    type: exitcode-stdio-1.0
    main-is: CoreSpec.hs
    hs-source-dirs: test, src
    other-modules: Zufallswerk.Core
    default-language: Haskell2010
    build-depends:
        base >= 4.17 && < 5,
        bytestring,
        directory
    ghc-options: -Wall
